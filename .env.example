# ── Clé API Google Gemini (obligatoire) ──────────────────────────────────────
# Obtenir sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=votre_clé_gemini_ici

# ── Clé API Judilibre (optionnel mais recommandé pour les arrêts 2025-2026) ──
# Inscription gratuite sur : https://piste.gouv.fr
# 1. Créer un compte → valider l'e-mail
# 2. Créer une application → chercher "Judilibre"
# 3. Copier la clé KeyId ici
JUDILIBRE_API_KEY=votre_clé_judilibre_ici

# ── Port du serveur (optionnel, défaut : 3000) ────────────────────────────────
PORT=3000
